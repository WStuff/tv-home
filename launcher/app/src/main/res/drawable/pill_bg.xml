<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF2DDE3" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#59643B49" />
            <stroke android:width="1.5dp" android:color="#FFE9A2B5" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#424D3039" android:endColor="#2426171B" />
            <stroke android:width="1dp" android:color="#38E9A2B5" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
